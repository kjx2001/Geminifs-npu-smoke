/*----------------------custom ops-------------------*/
__host__ GPUFilePool* init_fds(size_t nr_files, size_t file_size, int device, int num_SSDs_per_gpu, std::string mount_prifix) {
    assert(nr_files > 0);
    // 为GPU指定nvme控制器
    char snvme_control_path[] = "/dev/snvm_control";
    std::vector<std::string> pci_addr;
    // 根据device信息指定对应的nvme设备
    for (int i = 0; i < num_SSDs_per_gpu; i++) {
        pci_addr.push_back(global_avaible_pci_addr[device * num_SSDs_per_gpu + i]);
    }

    struct geminifs_ctrl_params ctrl_params = {
        .mount_path = mount_prifix,
		.snvme_control_path = snvme_control_path,
        .pci_addr = pci_addr,
		.cudaDevice = device,
		.ns_id = 1,                         
		.queueDepth = 1024,    
		.numQueues = 64
	};
    cuda_check_error(cudaSetDevice(ctrl_params.cudaDevice));
    host_open_ctrls(&ctrl_params);
    assert(ctrls.size() > 0);
    assert(file_size % ctrls.size() == 0);
    // 根据时间创建pool_id
    GPUPoolId this_pool_id = (GPUPoolId)time(NULL);
    size_t nr_device = ctrls.size();
    GPUFilePool *pool;
    pool_id = this_pool_id;

    // cuda_check_error(cudaGetDevice(&device));
    file_size = ROUND_UP(file_size, GPU_PAGE_SIZE);
    auto files = geminifs_batch_create(nr_device, nr_files, GPU_PAGE_SIZE, file_size, device);
    cuda_check_error(cudaMalloc(&pool, sizeof(GPUFilePool)));
    
    RUN_ON_DEVICE({
        new (pool) GPUFilePool(files, file_size, nr_files);
        pool->set_pool_id(this_pool_id);
    });
    
    geminifs_info("pool_id %lu\n", pool_id);
    return pool;
}
// 如果传入的是指针，必要是设备指针，常量无所谓
__global__ void 
    __batch_xfer(GPUFilePool* global_pool,
                uint64_t *file_ids, 
                uint64_t *ioaddr, 
                size_t file_offset, 
                size_t nbytes,
                enum FileXferType type, 
                size_t batch_size) {

    size_t nr_block = gridDim.x;
    size_t nr_thread_per_block = blockDim.x;
    size_t nbytes__per_thread = nbytes / 32;

    assert(nr_block == batch_size);
    assert(nr_thread_per_block == 32);

    int lane = my_lane_id();    
    size_t this_thread_file_offset = file_offset + lane * nbytes__per_thread;
    int file_id = blockIdx.x;
    // TODO: 如何取到历史pool的文件
    auto file = global_pool->get_file(file_id);
    if (lane == 0) {
        file->scatter_ioaddrs(ioaddr, file_offset, nbytes);
    }
    __syncwarp();

    if (type == FILE_XFER_READ) {
        file->read_in(this_thread_file_offset, nbytes__per_thread);
    } else {
        file->write_out(this_thread_file_offset, nbytes__per_thread);
    }
}
/*----------------------custom ops-------------------*/

// 优化TODO: 避免调用cudaMalloc、memcopy以及cudaDeviceSynchronize
bool batch_read_direct(const torch::Tensor& cached_file_ids,    // len = [ceil(num_tokens/chunk_size)]
                                       const torch::Tensor& keys,               // shape = [num_layers, num_tokens, num_heads, head_size]
                                       const torch::Tensor& values,             //shape = [num_layers, num_tokens, num_heads, head_size]
                                       int64_t chunk_size,  // default = 256
                                       int64_t start_layer_idx,
                                       int64_t layers // default=1
                                      ) {
    std::cout<< "start call batch_read_direct" << std::endl;

    uint64_t* file_ids_ptr = cached_file_ids.data_ptr<uint64_t>();
    int num_files = cached_file_ids.size(0);
    std::cout << "cached_file_ids" << cached_file_ids << "num_files: " << num_files << std::endl;
    
    int num_tokens = keys.size(0);
    int total_num_heads = keys.size(1);
    int head_size = keys.size(2);
    int element_size = keys.element_size();
    int device = keys.device().index();
    int deviceCount = 1;
    // cudaError_t error = cudaGetDeviceCount(&deviceCount);
    // if (error != cudaSuccess) {
    //     geminifs_info("cudaGetDeviceCount failed: %s\n", cudaGetErrorString(error));
    //     return false;
    // }

    // uint64_t num_heads_per_device = total_num_heads / deviceCount;
    // 一个文件内应该是存储chunk_size长度num_layers的kv,因此存储tensor的shape应该为[num_layers, 2, chunk_size, num_heads, head_size]
    // 以下操作为计算访存文件的偏移量，其中key存在[0]，value存在[1]
    // 因此每一层的偏移量为2 * chunk_size * num_heads * head_size * element_size
    // 因此每一层的key的偏移量为， value的偏移量为
    uint64_t size_of_one_kv_tensor_in_layer = chunk_size * total_num_heads * head_size * element_size;
    uint64_t layer_stride = 2 * size_of_one_kv_tensor_in_layer;
    uint64_t key_file_offset = start_layer_idx * layer_stride;
    uint64_t value_file_offset = start_layer_idx * layer_stride + size_of_one_kv_tensor_in_layer;


    
    uint64_t layer_stride = 2 * chunk_size * num_heads * head_size * element_size;
    uint64_t key_stride = chunk_size * num_heads_per_device * head_size * element_size;
    uint64_t key_file_offset = start_layer_idx * layer_stride;
    uint64_t value_file_offset = start_layer_idx * layer_stride + key_stride;
    std::cout << "ready to call read, key_file_offset: " << key_file_offset << ", value_file_offset: " << value_file_offset << std::endl;


    uint64_t key_nbytes = ROUND_UP(keys.numel() * keys.element_size(), GPU_PAGE_SIZE);
    uint64_t value_nbytes = ROUND_UP(values.numel() * values.element_size(), GPU_PAGE_SIZE);

    // 根据device信息指定对应的控制器
    int first_control_idx = device * num_SSDs_per_gpu_global;
    DmaPtr key_ioaddr = createDmaTest(first_control_idx, key_nbytes, device);
    DmaPtr value_ioaddr = createDmaTest(first_control_idx, value_nbytes, device);
    uint64_t* key_ioaddr_ptr = key_ioaddr.get()->ioaddrs;
    uint64_t* value_ioaddr_ptr = value_ioaddr.get()->ioaddrs;
    TORCH_CHECK(key_ioaddr_ptr != nullptr, "Failed to get DMA pointer for keys");
    TORCH_CHECK(value_ioaddr_ptr != nullptr, "Failed to get DMA pointer for values");

    uint64_t *d_key_ioaddr;
    uint64_t *d_value_ioaddr;
    cuda_check_error(cudaMalloc(&d_key_ioaddr, sizeof(uint64_t) *  key_ioaddr.get()->n_ioaddrs));
    cuda_check_error(cudaMalloc(&d_value_ioaddr, sizeof(uint64_t) * value_ioaddr.get()->n_ioaddrs));
    cuda_check_error(cudaMemcpy(d_key_ioaddr, key_ioaddr_ptr, sizeof(uint64_t) *  key_ioaddr.get()->n_ioaddrs, cudaMemcpyHostToDevice));
    cuda_check_error(cudaMemcpy(d_value_ioaddr, value_ioaddr_ptr, sizeof(uint64_t) * value_ioaddr.get()->n_ioaddrs, cudaMemcpyHostToDevice));
	
    dim3 grid(num_files);
    dim3 block(32);
    const at::cuda::OptionalCUDAGuard device_guard(device_of(keys));
    const cudaStream_t stream = at::cuda::getCurrentCUDAStream();
    
    is_device_pointer(global_pool, "global_pool must be device ptr");
    is_device_pointer(file_ids_ptr, "file_ids_ptr must be device ptr");
    is_device_pointer(d_key_ioaddr, "key_ioaddr must be device ptr");
    is_device_pointer(d_value_ioaddr, "value_ioaddr must be device ptr");
   

    __batch_xfer<<<grid, block, 0, stream>>>(global_pool, file_ids_ptr, d_key_ioaddr, key_file_offset, key_nbytes, FILE_XFER_READ, num_files);
    cudaDeviceSynchronize();
    geminifs_info("batch xfer_read keys success\n");

    __batch_xfer<<<grid, block, 0, stream>>>(global_pool, file_ids_ptr, d_value_ioaddr, value_file_offset, value_nbytes, FILE_XFER_READ, num_files);
    cudaDeviceSynchronize();
    geminifs_info("batch xfer_read values success\n");

    // 确保keys和values内存是连续的
    cudaMemcpy(keys.data_ptr(), key_ioaddr->vaddr, keys.numel() * keys.element_size(), cudaMemcpyDeviceToDevice);
	cudaMemcpy(values.data_ptr(), value_ioaddr->vaddr, values.numel() * values.element_size(), cudaMemcpyDeviceToDevice);
    TORCH_CHECK(cudaGetLastError() == cudaSuccess, "CUDA error in batch_read transfer");

    return true;
}

bool batch_write_direct(const torch::Tensor& file_ids,    // shape = [ceil(num_tokens/chunk_size)]
                                        const torch::Tensor& keys,               // shape = [num_tokens, num_heads, head_size]
                                        const torch::Tensor& values,             //shape = [num_tokens, num_heads, head_size]
                                        int64_t chunk_size,  // default = 256
                                        int64_t start_layer_idx,
                                        int64_t layers // default = 1
                                      ) {
    TORCH_CHECK(keys.device().is_cuda(), "Keys tensor must be on CUDA device");
    TORCH_CHECK(values.device().is_cuda(), "Values tensor must be on CUDA device");
    TORCH_CHECK(keys.sizes() == values.sizes(), "Keys and values must have same shape");
    
    // std::cout << "call batch_write_direct" << std::endl;
    uint64_t* file_ids_ptr = file_ids.data_ptr<uint64_t>();
    int num_files = file_ids.size(0);
    
    int num_tokens = keys.size(0);
    int total_num_heads = keys.size(1);
    int head_size = keys.size(2);
    int element_size = keys.element_size();
    uint64_t key_nbytes = keys.numel() * keys.element_size();
    uint64_t value_nbytes = values.numel() * values.element_size();
   
    int device = keys.device().index();
   
    int deviceCount = 1;
    // cudaError_t error = cudaGetDeviceCount(&deviceCount);
    // if (error != cudaSuccess) {
    //     geminifs_info("cudaGetDeviceCount failed: %s\n", cudaGetErrorString(error));
    //     return false;
    // }
    // std::cout << "file ids: " << file_ids << std::endl;
    geminifs_info("deviceCount: %d, file_ids: %p, keys: %p, values: %p, chunk_size: %ld, start_layer_idx: %ld\n", 
                 deviceCount, file_ids.data_ptr(), keys.data_ptr(), values.data_ptr(), chunk_size, start_layer_idx);
    uint64_t num_heads_per_device = total_num_heads / deviceCount;
    uint64_t layer_stride = 2 * chunk_size * num_heads_per_device * head_size * element_size;
    uint64_t key_stride = chunk_size * num_heads_per_device * head_size * element_size;
    uint64_t key_file_offset = start_layer_idx * layer_stride;
    uint64_t value_file_offset = start_layer_idx * layer_stride + key_stride;
    std::cout << "ready to call write, key_file_offset: " << key_file_offset << ", value_file_offset: " << value_file_offset << std::endl;
    // 确保内存与GPU Page Size对齐
    key_nbytes = ROUND_UP(key_nbytes, GPU_PAGE_SIZE);
    value_nbytes = ROUND_UP(value_nbytes, GPU_PAGE_SIZE);

    // 根据device信息指定对应的控制器
    int first_control_idx = device * num_SSDs_per_gpu_global;
    DmaPtr key_ioaddr = createDmaTest(first_control_idx, key_nbytes, device);
    DmaPtr value_ioaddr = createDmaTest(first_control_idx, value_nbytes, device);
    uint64_t* key_ioaddr_ptr = key_ioaddr.get()->ioaddrs;
    uint64_t* value_ioaddr_ptr = value_ioaddr.get()->ioaddrs;

    TORCH_CHECK(key_ioaddr_ptr != nullptr, "Failed to get DMA pointer for keys");
    TORCH_CHECK(value_ioaddr_ptr != nullptr, "Failed to get DMA pointer for values");
    
    uint64_t *d_key_ioaddr;
    uint64_t *d_value_ioaddr;
    cuda_check_error(cudaMalloc(&d_key_ioaddr, sizeof(uint64_t) *  key_ioaddr.get()->n_ioaddrs));
    cuda_check_error(cudaMalloc(&d_value_ioaddr, sizeof(uint64_t) * value_ioaddr.get()->n_ioaddrs));
    cuda_check_error(cudaMemcpy(d_key_ioaddr, key_ioaddr_ptr, sizeof(uint64_t) *  key_ioaddr.get()->n_ioaddrs, cudaMemcpyHostToDevice));
    cuda_check_error(cudaMemcpy(d_value_ioaddr, value_ioaddr_ptr, sizeof(uint64_t) * value_ioaddr.get()->n_ioaddrs, cudaMemcpyHostToDevice));
	
    // MemoryCopyD2D
    cudaMemcpy(key_ioaddr->vaddr, keys.data_ptr(), keys.element_size() * keys.numel(), cudaMemcpyDeviceToDevice);
	cudaMemcpy(value_ioaddr->vaddr, values.data_ptr(), values.element_size() * values.numel(), cudaMemcpyDeviceToDevice);

    dim3 grid(num_files);
    dim3 block(32);
    const at::cuda::OptionalCUDAGuard device_guard(device_of(keys));
    const cudaStream_t stream = at::cuda::getCurrentCUDAStream();
 
    is_device_pointer(global_pool, "global_pool must be device ptr");
    is_device_pointer(file_ids_ptr, "file_ids_ptr must be device ptr");
    is_device_pointer(d_key_ioaddr, "key_ioaddr must be device ptr");
    is_device_pointer(d_value_ioaddr, "value_ioaddr must be device ptr");
 
    __batch_xfer<<<grid, block, 0, stream>>>(global_pool, file_ids_ptr, d_key_ioaddr, key_file_offset, key_nbytes, FILE_XFER_WRITE, num_files);
    cudaDeviceSynchronize();
    geminifs_info("batch xfer keys success\n");

    __batch_xfer<<<grid, block, 0, stream>>>(global_pool, file_ids_ptr, d_value_ioaddr, value_file_offset, value_nbytes, FILE_XFER_WRITE, num_files);
    cudaDeviceSynchronize();
    geminifs_info("batch xfer values success\n");
    TORCH_CHECK(cudaGetLastError() == cudaSuccess, "CUDA error in batch transfer");
 
    return true;
}

// bool geminifs_init_fds_wrapper_cuda(const torch::Tensor& metadata, const torch::Tensor& root_path) {
bool geminifs_init_fds_wrapper_cuda(const torch::Tensor& metadata, const std::string& nvme_config_path) {

    // TODO: 解析nvme_config_path
    TORCH_CHECK(metadata.dim() == 1, "Input must be a 1D tensor");
    TORCH_CHECK(metadata.size(0) == 3, "Input must have exactly 3 elements");
  
    size_t nr_files = metadata[0].item<int64_t>();  
    size_t file_size = metadata[1].item<int64_t>();  
    int num_SSDs_per_gpu = metadata[2].item<int64_t>();
    num_SSDs_per_gpu_global = num_SSDs_per_gpu;
    // 获取当前设备ID
    int device = metadata.device().index();
    
    // TODO:  打开历史的文件，根据pool id？user id，user id可以预先打开

    // 创建新的empty file
    global_pool = init_fds(nr_files, 
                        file_size, 
                        device,  // 添加device参数
                        num_SSDs_per_gpu,
                        nvme_config_path);

    geminifs_info("init fds success, pool id is: %p\n", global_pool);
    cudaDeviceSynchronize();
    return true;
}
