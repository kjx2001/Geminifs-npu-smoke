/*--------------------utils---------------------*/
std::string parse_tensor_to_string(const torch::Tensor& tensor) {
    torch::Tensor cpu_tensor = tensor.to(torch::kCPU);
        
    uint8_t* data_ptr = cpu_tensor.data_ptr<uint8_t>();
    
    size_t actual_length = 0;
    while (actual_length < cpu_tensor.size(0) && data_ptr[actual_length] != 0) {
        actual_length++;
    }
    
    std::string result(reinterpret_cast<char*>(data_ptr), actual_length);
    return result;
}

template <typename T>
torch::Tensor wrap_address(T* ptr, bool is_cuda_ptr = false) {
    static_assert(sizeof(uintptr_t) <= sizeof(uint64_t), 
                 "Pointer size exceeds 64 bits, casting may truncate");

    uint64_t addr = reinterpret_cast<uint64_t>(ptr);
    uint64_t size = sizeof(T);

    torch::TensorOptions options(torch::kUInt64);
    if (is_cuda_ptr) {
        options = options.device(torch::kCUDA);
    }

    return torch::from_blob(
        &addr, 
        {2}, 
        options
    ).clone().view({1, 2}); 
}

template <typename T>
T* unwrap_address(const torch::Tensor& tensor) {
    // 直接使用张量所在设备的数据指针
    auto data = tensor.device().is_cuda() 
        ? tensor.data_ptr<uint64_t>() 
        : tensor.to(torch::kCPU).data_ptr<uint64_t>();

    uint64_t addr = data[0];
    uint64_t size = data[1];

    TORCH_CHECK(size == sizeof(T), 
                "Size mismatch: expected {}, got {}", 
                sizeof(T), size);

    return reinterpret_cast<T*>(addr);
}


/**
 * 检查指针是否为CUDA设备指针
 */
bool is_device_pointer(const void* ptr, const char* error_msg = nullptr) {
    cudaPointerAttributes attrs;
    cudaError_t err = cudaPointerGetAttributes(&attrs, ptr);
    
    bool is_device = (err == cudaSuccess && attrs.type == cudaMemoryTypeDevice);
    
    if (error_msg != nullptr && !is_device) {
        TORCH_CHECK(false, error_msg);
    }
    
    return is_device;
}


